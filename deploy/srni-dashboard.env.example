# Variables de entorno del SRNI Dashboard en Analiticarni.
# instalar.sh genera ~/servers/srni-dashboard/srni-dashboard.env a partir de este
# archivo con una DJANGO_SECRET_KEY aleatoria. Permisos 600. No versionar el .env real.
DJANGO_SECRET_KEY=__GENERADA_POR_INSTALAR_SH__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sinapsis.unidadvictimas.gov.co,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://sinapsis.unidadvictimas.gov.co
DJANGO_BEHIND_HTTPS_PROXY=True
# Prefijo de publicación: Gunicorn lo usa para separar la ruta de la app.
SCRIPT_NAME=/srni-dashboard
# Datos fuera del código: una actualización del repo no los toca.
DJANGO_DB_PATH=__HOME__/servers/srni-dashboard/datos/db.sqlite3
DJANGO_MEDIA_ROOT=__HOME__/servers/srni-dashboard/datos/media
# Libro maestro de contratación (botón "Sincronizar"). No se copia al servidor por
# defecto: contiene honorarios y datos de contratistas. Si se decide copiarlo:
# DJANGO_CONTRATOS_XLSX_PATH=__HOME__/servers/srni-dashboard/datos/Contratos SRNI 2026.xlsx
